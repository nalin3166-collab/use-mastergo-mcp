{
  "name": "use-mastergo-mcp",
  "version": "0.1.0",
  "description": "High-throughput MCP server for direct MasterGo canvas reading, writing, batch image upload, and visual screenshot verification",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nalin3166-collab/use-mastergo-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalin3166-collab/use-mastergo-mcp.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/nalin3166-collab/use-mastergo-mcp/issues"
  },
  "keywords": [
    "mastergo",
    "mcp",
    "model-context-protocol",
    "ai-design",
    "design-automation",
    "use-mastergo",
    "mastergo-plugin"
  ],
  "bin": {
    "use-mastergo-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@use-mastergo-mcp/protocol": "workspace:*",
    "sharp": "^0.34.1",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1"
  }
}
